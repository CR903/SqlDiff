# Preflight E2E 环境变量示例。复制为 .env.e2e 并填入真实密码。
# .env.e2e 需手动追加到 apps/desktop/.gitignore 中（本任务不改 .gitignore）。

# 目标 1: MySQL 8.0.46 (INSTANT ADD + INSTANT DROP 均支持)
E2E_MYSQL_9_HOST=192.168.5.9
E2E_MYSQL_9_PORT=3306
E2E_MYSQL_9_USER=root
E2E_MYSQL_9_PASSWORD=<pw>
E2E_MYSQL_9_DATABASE=sqldiff_preflight_test_8_0_46

# 目标 2: MySQL 8.0.26 (INSTANT ADD 支持，INSTANT DROP 不支持)
E2E_MYSQL_15_HOST=192.168.5.15
E2E_MYSQL_15_PORT=3306
E2E_MYSQL_15_USER=root
E2E_MYSQL_15_PASSWORD=<pw>
E2E_MYSQL_15_DATABASE=sqldiff_preflight_test_8_0_26

# 开关：设为 1 时才运行 preflight e2e spec（默认 0，主 harness 保持安静）
E2E_RUN_PREFLIGHT_MYSQL=0

# 目标 3: MySQL 5.7.x (INPLACE baseline：ADD/DROP COLUMN 均走 INPLACE + rebuild)
E2E_MYSQL_57_HOST=192.168.2.84
E2E_MYSQL_57_PORT=3306
E2E_MYSQL_57_USER=root
E2E_MYSQL_57_PASSWORD=<pw>
E2E_MYSQL_57_DATABASE=sqldiff_preflight_test_5_7

# 开关：设为 1 时才运行 5.7 preflight e2e spec（默认 0，与 8.x 开关独立）
E2E_RUN_PREFLIGHT_MYSQL57=0
