# Preflight 真机 E2E 环境变量示例。
#
# 用法：复制为 apps/desktop/.env.e2e，填入真实 host 与密码，然后直接
#   npm run e2e:preflight:mysql      # MySQL 8.0.46
#   npm run e2e:preflight:mysql57    # MySQL 5.7
# 无需手工 export 任何变量 —— e2e/playwright.config.ts 会用 dotenv 自动加载本文件。
#
# 加载语义（重要）：
#   - 已存在的 process.env 键**不会被本文件覆盖**。命令行 / CI 注入的值优先，
#     所以 `E2E_MYSQL_57_PASSWORD=xxx npm run e2e:preflight:mysql57` 会真的用 xxx。
#   - 本文件缺失是正常状态：`npm run e2e` 主 harness 不需要它，此时整套 preflight
#     spec 静默 skip。
#
# 本文件**不要填真实密码后提交**。`.env.e2e` 已在 .gitignore 中；本示例只保留占位。

# ---------------------------------------------------------------------------
# 为什么 host 不提供代码默认值
# ---------------------------------------------------------------------------
# preflight 真机 E2E 的目标机是**虚拟机，IP 每次重启都会变**。所以 host 只能从这里
# 传入，代码里刻意没有默认值：一旦写死，IP 变了以后 spec 要么静默 skip（看不出原因），
# 要么**连到错误的那台机器**——后者更糟，因为它看起来跑通了。
# 缺失 host 时 spec 会 skip 并点名缺哪个变量，不会偷偷去连某个地址。

# 目标 1: MySQL 8.0.46 —— INSTANT ADD + INSTANT DROP 均支持（能力顶端）
# 变量名沿用历史 E2E_MYSQL_9_*；单机化后 `9` 只是不透明标签，版本语义看下方 DATABASE 与 describe 名。
E2E_MYSQL_9_HOST=<your-mysql-8.0.46-host>
E2E_MYSQL_9_PORT=3306
E2E_MYSQL_9_USER=root
E2E_MYSQL_9_PASSWORD=<pw>
E2E_MYSQL_9_DATABASE=sqldiff_preflight_test_8_0_46

# 开关：设为 1 时才运行 8.x preflight e2e spec（默认 0，主 harness 保持安静）
E2E_RUN_PREFLIGHT_MYSQL=0

# 目标 2: MySQL 5.7 —— INPLACE baseline（ADD/DROP COLUMN 均走 INPLACE + rebuild，能力下界）
# 该机 root 仅有 root@localhost，需用专门的远程账号（host '%'）：
#   GRANT ALL PRIVILEGES ON `sqldiff_preflight_test_5_7`.* TO '<user>'@'%';
#   GRANT SELECT, REPLICATION CLIENT, SUPER ON *.* TO '<user>'@'%';
# SUPER 唯一用途是 READ_ONLY_TARGET 用例的 SET GLOBAL read_only（spec 的 finally 会还原）。
E2E_MYSQL_57_HOST=<your-mysql-5.7-host>
E2E_MYSQL_57_PORT=3306
E2E_MYSQL_57_USER=<remote-user>
E2E_MYSQL_57_PASSWORD=<pw>
E2E_MYSQL_57_DATABASE=sqldiff_preflight_test_5_7

# 开关：设为 1 时才运行 5.7 preflight e2e spec（默认 0，与 8.x 开关独立）
E2E_RUN_PREFLIGHT_MYSQL57=0
