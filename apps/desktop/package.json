{
  "name": "sqldiff-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SqlDiff 桌面版（Electron + Vite + React + TS）—— MySQL 结构对比，离线可用",
  "main": "dist-main/src-main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --mac"
  },
  "dependencies": {
    "electron": "^34.0.0",
    "monaco-editor": "^0.52.2",
    "mysql2": "^3.12.0",
    "sql-formatter": "^15.4.6",
    "ssh2": "^1.16.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
